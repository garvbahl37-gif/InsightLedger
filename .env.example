# Copy to .env and fill in. Every value has a safe default so the system runs
# fully on stub backends with NOTHING set.

# ---- Backend selection (auto = use real backend if deps/keys present, else stub) ----
IL_EMBEDDER=auto          # auto | colqwen | stub
IL_VECTOR_STORE=auto      # auto | qdrant | memory
IL_LLM=auto               # auto | claude | stub
IL_GRAPH=auto             # auto | langgraph | linear

# Runs FULLY LOCAL by default (deterministic grounded stub — no API, no key).
# Optionally set ANTHROPIC_API_KEY to use Claude for production-grade generation.

# ---- Claude (optional, paid) ----
ANTHROPIC_API_KEY=
IL_LLM_MODEL=claude-opus-4-8
IL_LLM_MODEL_CHEAP=claude-haiku-4-5-20251001

# ---- ColQwen visual retrieval (optional, local GPU) ----
IL_COLQWEN_MODEL=vidore/colqwen2-v1.0
IL_DEVICE=auto            # auto | cpu | cuda

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- SEC EDGAR (required by SEC fair-access policy: a real UA with contact) ----
IL_EDGAR_USER_AGENT=InsightLedger research vian@recollia.ai

# ---- Retrieval / routing knobs ----
IL_TOP_K=5
IL_VERIFY_MIN_CONFIDENCE=0.6
IL_DATA_DIR=./data

# ---- Observability ----
IL_TRACE=1                # 1 = write JSONL traces to data/traces
