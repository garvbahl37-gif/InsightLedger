# Copy to .env and fill in. Every value has a safe default so the system runs
# fully on stub backends with NOTHING set.

# ---- Backend selection (auto = use real backend if deps+keys present, else stub) ----
IL_EMBEDDER=auto          # auto | colqwen | stub
IL_VECTOR_STORE=auto      # auto | qdrant | memory
IL_LLM=auto               # auto | claude | hf | ollama | stub
IL_GRAPH=auto             # auto | langgraph | linear

# LLM ladder (auto): HF Inference (if HF_TOKEN) > Claude (if key) > local HF
# model (if torch+transformers) > stub. For a LIVE/DEPLOYED app use HF Inference
# — HF hosts the model, so no GPU/RAM/disk locally; only a FREE token is needed.

# ---- HuggingFace Inference Providers (LIVE, serverless — recommended for deploy) ----
# Get a free token: https://huggingface.co/settings/tokens  (role: read/inference)
HF_TOKEN=
IL_HF_API_MODEL=Qwen/Qwen2.5-7B-Instruct   # or meta-llama/Llama-3.1-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.3
# then: export IL_LLM=hf-api   (or leave auto — it's picked when HF_TOKEN is set)

# ---- HuggingFace local open model (in-process; needs compute, no key) ----
IL_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # or *-0.5B-Instruct (low RAM), Llama-3.2-3B-Instruct
IL_HF_DEVICE=auto         # auto | cpu | cuda
IL_HF_MAX_NEW_TOKENS=512
# Point the model cache at a drive with space (weights are ~1-6 GB):
IL_HF_CACHE=              # e.g. D:/hf-cache   (sets HF_HOME)

# ---- Claude (paid, best quality) ----
ANTHROPIC_API_KEY=
IL_LLM_MODEL=claude-opus-4-8
IL_LLM_MODEL_CHEAP=claude-haiku-4-5-20251001

# ---- Ollama (optional local server; only when IL_LLM=ollama explicitly) ----
IL_OLLAMA_URL=http://localhost:11434
IL_OLLAMA_MODEL=qwen2.5:7b

# ---- ColQwen visual retrieval ----
IL_COLQWEN_MODEL=vidore/colqwen2-v1.0
IL_DEVICE=auto            # auto | cpu | cuda

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- SEC EDGAR (required by SEC fair-access policy: a real UA with contact) ----
IL_EDGAR_USER_AGENT=InsightLedger research vian@recollia.ai

# ---- Retrieval / routing knobs ----
IL_TOP_K=5
IL_VERIFY_MIN_CONFIDENCE=0.6
IL_DATA_DIR=./data

# ---- Observability ----
IL_TRACE=1                # 1 = write JSONL traces to data/traces
